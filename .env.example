# Copy this file to .env and paste your Base mainnet RPC URL (Alchemy or QuickNode free tier).
# .env is in .gitignore so the key never reaches GitHub.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Optional second provider (e.g. Ankr free plan). Scans alternate between the two so
# neither runs out of its monthly quota. Leave it out to run on BASE_RPC_URL alone.
RPC_URL_2=https://rpc.ankr.com/base/YOUR_KEY_HERE
